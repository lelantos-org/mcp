# --- what it proxies, and what that costs -------------------------------------
# Upstream servers and per-tool prices live in JSON, not here: they are topology,
# not deployment. See mcp.config.example.json.
MCP_CONFIG=mcp.config.json

# --- where payment goes -------------------------------------------------------
# Defaults to the watch wallet's own address. Set it only to override, and only
# to an address this wallet's viewing key can see — a note it cannot decrypt is
# a payment it cannot accept.
# MCP_PAY_TO=lelantos1...

# --- verification -------------------------------------------------------------
MCP_CHAIN_ID=31337
LELANTOS_VIEWING_KEY=lelantosivk1...
LELANTOS_NETWORK=anvil
LELANTOS_RPC_URL=http://127.0.0.1:8545
MCP_VERIFY_TIMEOUT_MS=30000

# Accept any well-formed receipt without checking the chain. Replay protection
# still applies. Never set this where a real payer can reach the server.
# MCP_DEV_ACCEPT_UNVERIFIED=1

# --- paying upstreams from a transparent balance -------------------------------
# Only needed for upstreams marked "payment": "transparent". This key spends; the
# shielded viewing key above cannot. Fund it with the float you are willing to
# lose if this host is compromised.
# MCP_EVM_PRIVATE_KEY=0x...
# MCP_EVM_CHAIN_ID=8453              # defaults to MCP_CHAIN_ID
# One ceiling per token, in that token's base units. Required with the key, and
# per token because base units are denominated in the token: 1000000 is 1 USDC
# at six decimals and 1e-12 WETH at eighteen. The tokens named here are also the
# allowlist — a token with no ceiling is not paid.
# MCP_EVM_MAX_PER_CALL=0xA0b8...=1000000,0xC02a...=500000000000000
#
# Legacy shorthand: a bare amount, only when MCP_EVM_TOKENS names exactly one.
# MCP_EVM_MAX_PER_CALL=1000000
# MCP_EVM_TOKENS=0xA0b8...

# --- server -------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8402
MCP_PUBLIC_URL=http://127.0.0.1:8402/mcp
MCP_SERVICE_NAME=lelantos-mcp
MCP_TIMEOUT_SECONDS=60
MCP_LEDGER=consumed.log
MCP_MAX_BODY_BYTES=1048576
